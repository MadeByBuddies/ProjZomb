<Application x:Class="ProjZomb.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#18232D"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#101820"/><Setter Property="Foreground" Value="#E4EBEF"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5,0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#233440"/><Setter Property="Foreground" Value="#F1F5F7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#3C5362"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,8,8"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Background" Value="#C2DEB2"/><Setter Property="Foreground" Value="#101820"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Padding" Value="7"/><Setter Property="Foreground" Value="#101820"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="Foreground" Value="#101820"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#E4EBEF"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
 </Application.Resources>
</Application>
